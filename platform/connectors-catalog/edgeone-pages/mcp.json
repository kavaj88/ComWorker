{
  "mcpServers": {
    "edgeone-pages": {
      "timeout": 600,
      "command": "npx",
      "args": [
        "edgeone-pages-mcp-fullstack@latest",
        "--region",
        "china"
      ],
      "runtime": {
        "type": "node",
        "version": ">=20"
      },
      "type": "streamable_http",
      "transport": "streamable_http"
    }
  }
}