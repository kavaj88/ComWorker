{
  "mcpServers": {
    "gangtise-mcp": {
      "type": "streamable_http",
      "url": "https://openapi.gangtise.com/application/open-mcp/",
      "headers": {
        "accessKey": "${GTS_ACCESS_KEY}",
        "secretKey": "${GTS_SECRET_KEY}"
      },
      "timeout": 60000,
      "transport": "streamable_http"
    }
  }
}